## 9. Shader Library

### 9.1 Holographic Material

```glsl
// Vertex Shader
varying vec3 vNormal;
varying vec3 vPosition;

void main() {
  vNormal = normalize(normalMatrix * normal);
  vPosition = position;
  gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
}

// Fragment Shader
uniform float time;
uniform vec3 glowColor; // Magenta

varying vec3 vNormal;
varying vec3 vPosition;

void main() {
  // Fresnel effect (edge glow)
  float fresnel = pow(1.0 - dot(vNormal, vec3(0, 0, 1)), 3.0);
  
  // Scanlines
  float scanline = sin(vPosition.y * 50.0 + time * 2.0) * 0.5 + 0.5;
  
  // Holographic flicker
  float flicker = sin(time * 10.0) * 0.1 + 0.9;
  
  // Combine
  vec3 glow = glowColor * fresnel * scanline * flicker;
  
  gl_FragColor = vec4(glow, fresnel * 0.7);
}
```

### 9.2 Glitch Shader

```glsl
uniform sampler2D tDiffuse;
uniform float glitchIntensity;
uniform float time;

varying vec2 vUv;

float random(vec2 st) {
  return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 43758.5453123);
}

void main() {
  vec2 uv = vUv;
  
  // RGB shift
  float shift = glitchIntensity * 0.05;
  float r = texture2D(tDiffuse, uv + vec2(shift, 0.0)).r;
  float g = texture2D(tDiffuse, uv).g;
  float b = texture2D(tDiffuse, uv - vec2(shift, 0.0)).b;
  
  // Horizontal displacement
  float disp = random(vec2(floor(uv.y * 20.0), time)) * glitchIntensity;
  if (disp > 0.9) {
    uv.x += (random(vec2(time)) - 0.5) * 0.1;
  }
  
  vec3 color = vec3(r, g, b);
  gl_FragColor = vec4(color, 1.0);
}
```

### 9.3 Neon Glow Shader

```glsl
uniform vec3 glowColor;
uniform float glowIntensity;
uniform float glowRadius;

varying vec2 vUv;
varying vec3 vPosition;

void main() {
  // Distance from edge
  float dist = length(vUv - 0.5) * 2.0;
  
  // Glow falloff
  float glow = 1.0 - smoothstep(0.0, glowRadius, dist);
  glow = pow(glow, 2.0) * glowIntensity;
  
  // Pulse
  float pulse = sin(time * 2.0) * 0.3 + 0.7;
  
  vec3 finalGlow = glowColor * glow * pulse;
  gl_FragColor = vec4(finalGlow, glow);
}
```

